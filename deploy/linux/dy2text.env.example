# 独立项目配置：复制为 ~/dy2text-public/dy2text.env 并 chmod 600。
# 生产默认免密码；把 DOUYIN_REQUIRE_AUTH 改为 1 即可恢复口令保护。
DOUYIN_REQUIRE_AUTH=0
DOUYIN_SERVER_TOKEN=REDACTED_REPLACE_LOCALLY
DOUYIN_SERVER_HOST=127.0.0.1
DOUYIN_SERVER_PORT=8766
DOUYIN_DATA_DIR=/home/ubuntu/dy2text-public/data
DOUYIN_BACKENDS=browser,iesdouyin,ytdlp
DOUYIN_COOKIES_FILE=/home/ubuntu/dy2text-public/secrets/douyin-anon-cookies.txt
# 只用于创建匿名浏览器会话；不要填需要登录或私密的作品。
DOUYIN_COOKIE_SEED_URL=https://www.douyin.com/video/7685682624978832691
# Playwright 默认下载 headless-shell；若部署的是完整 Chromium，显式指定它。
DOUYIN_CHROMIUM_EXECUTABLE=/home/ubuntu/dy2text-public/playwright-browsers/chromium-1243/chrome-linux64/chrome
DOUYIN_KEEP_VIDEO=1
DOUYIN_VIDEO_TTL_HOURS=24
DOUYIN_VIDEO_MAX_GB=2
DOUYIN_ASR_MODEL=sherpa-sensevoice
DOUYIN_SHERPA_MODEL_DIR=/home/ubuntu/dy2text-public/models/sensevoice
DOUYIN_ASR_THREADS=2
# 小内存服务器：每次转写后释放模型；下次任务会重新加载（增加几秒）。
DOUYIN_RELEASE_ASR_AFTER_JOB=1
MALLOC_ARENA_MAX=2
DOUYIN_FFMPEG=/home/ubuntu/dy2text-public/venv/bin/ffmpeg
DOUYIN_MIN_INTERVAL=3
# 视频号直链解析。生产值仅写入 chmod 600 的 env 文件，不要提交到 Git。
WECHAT_REQUIRE_AUTH=1
WECHAT_YUANBAO_COOKIE=
PYTHONPATH=/home/ubuntu/dy2text-public/app
